{
  "name": "aicase-terminal",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4181 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts",
    "package": "npm run build && python3 scripts/package.py",
    "build:embedded": "tsc --noEmit && vite build --config vite.embedded.config.ts",
    "dev:supplier": "npm run build:embedded && npm --prefix supplier-host run dev",
    "build:supplier": "npm run build:embedded && npm --prefix supplier-host run build",
    "package:supplier": "npm run build:supplier && python3 scripts/package_supplier.py",
    "test:supplier": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
