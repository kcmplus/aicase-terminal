# Public customer website only. All VITE_* values are visible in the bundle.
# Leave unset to use get_machine_info().h5_base_url from the terminal host.
VITE_STOREFRONT_URL=https://aicase.chunpat.cc/
VITE_DEFAULT_LANGUAGE=en-US
# External paid-order payment type confirmed by the project owner.
# The supplier IPC expects a string, so the submitted value is "free".
VITE_EXTERNAL_PAYMENT_TYPE=free
