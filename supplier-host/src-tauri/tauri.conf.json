{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "phonecase-diy-gy",
  "version": "2.0.1",
  "identifier": "com.wm.phonecase-diy-gy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "phonecase-diy-gy",
        "width": 1080,
        "height": 1920,
        "fullscreen": true,
        "alwaysOnTop": true,
        "decorations": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "configs/pc/*",
      "locales/default/*",
      "locales/admin/*",
      "locales/basic/*",
      "locales/pc/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "./icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "dangerousInsecureTransportProtocol": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0MTU4MUE1MDkxMjcyNDMKUldSRGNoSUpwWUVWMURDNEZJcFkvWXZQZ00wMmVWL1hsTk1veTEveXhaTTNJUHNNMEYrZEtHMUgK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
